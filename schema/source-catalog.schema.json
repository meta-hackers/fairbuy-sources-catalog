{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-hackers.github.io/fairbuy-sources-catalog/schema/source-catalog.schema.json",
  "title": "FairBuy source catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "name", "roles", "verticals", "countries", "priority"],
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["seller", "marketplace", "spec", "review", "comparison"] }
        },
        "verticals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "countries": {
          "oneOf": [
            { "const": "global" },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 60,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
            }
          ]
        },
        "priority": { "enum": [1, 2, 3] },
        "note": { "type": "string", "maxLength": 300 },
        "enabled": { "type": "boolean" }
      }
    }
  }
}
